                    <option value="">Action</option>
                    <option value="">Platformer</option>
                </select> <br>

                <label for="imgPath">Image Foler Path: </label>
                <input type="text" id="price" name="price" required> <br>

                <label for="price">Description: </label>
                <textarea name="" id=""></textarea> <br>
                
                <label for="price">Description: </label>
                <textarea name="" id=""></textarea> <br>

                <label for="price">Short-Describe: </label>
                <textarea name="" id=""></textarea> <br>

                <br>
                <button type="submit" class="signinbutton">Save</button>
                <a href="/admin/games" class="signinbutton">Go back</a>
            </form>
        </div>
    </div>
    <%- include('footer') %>