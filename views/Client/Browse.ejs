<%- include('../Component/header') %>
        <div id="content">
            <div id="centre">

                <div id="searchDetail">
                    <div id="context">
                        <h1>Discover the STEPTH's Game store</h1>
                        <p>We have diverse game genres with many popular game to explore</p>
                    </div>

                    
                    <div id="funcButton">
                        <label for="genreFilter">Genre filter</label> <br> <br>
                        <select name="genre" id="genreFilter" onchange="applyFilters()">
                            <option value="">All Genres</option>
                            <option value="RPG">RPG</option>
                            <option value="Soul-like">Soul-like</option>
                            <option value="Action">Action</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Strategy">Strategy</option>
                            <option value="Sports">Sports</option>
                        </select>
                    </div>
                    <div id="funcButton">
                        <label for="sortBy">Sort by</label> <br> <br>
                        <select name="sort" id="sortBy" onchange="applyFilters()">
                            <option value="name_asc">Name A-Z</option>
                            <option value="name_desc">Name Z-A</option>
                            <option value="price_asc">Price Low to High</option>
                            <option value="price_desc">Price High to Low</option>
                        </select>
                    </div>
                </div>

                <div id="browseList">
                    <% for (let i = 0; i < games.length; i++) { %>
                      <% if (i % 5 == 0 ) { %>
                        <div class="browseListRow">
                      <% } %>
                  
                      <div class="smallGameCard" onclick="GoToDetailPage(<%= games[i].ID %>)">
                        <img src="/assets/Images/<%= games[i].imgPath %>/Logo.png">
                        <h2><%= games[i].name %></h2>
                        <h3><%= games[i].price %> $</h3> 
                      </div>
                  
                      <% if (i % 5 == 4 ) { %>
                        </div>
                      <% } %>
                    <% } %>
                  </div>
                  

                <div id="changePage">
                    <!-- <h1>1 2 3 4 ... 10</h1> -->
                    <a href="">1</a>
                    <a href="">2</a>
                    <a href="">3</a>
                    <h5>...</h5>
                    <a href="">7</a>
                    <a href="">></a>
                </div>

            </div>
        </div>

<%- include('../Component/footer') %>

<script>
    const games = <%- JSON.stringify(games) %>;
    let filteredGames = [...games];

    // Get search keyword from URL
    const urlParams = new URLSearchParams(window.location.search);
    const searchKeyword = urlParams.get('keyword');

    function GoToDetailPage(gameID) {
        window.location.href = `/games/${gameID}`;
    }

    function applyFilters() {
        const genreFilter = document.getElementById('genreFilter').value;
        const sortBy = document.getElementById('sortBy').value;
        
        // Apply search filter first
        filteredGames = games.filter(game => {
            if (!searchKeyword) return true;
            return game.name.toLowerCase().includes(searchKeyword.toLowerCase());
        });

        // Then apply genre filter
        filteredGames = filteredGames.filter(game => {
            if (!genreFilter) return true;
            return game.genre === genreFilter;
        });

        // Finally apply sorting
        filteredGames.sort((a, b) => {
            switch(sortBy) {
                case 'name_asc':
                    return a.name.localeCompare(b.name);
                case 'name_desc':
                    return b.name.localeCompare(a.name);
                case 'price_asc':
                    return parseFloat(a.price) - parseFloat(b.price);
                case 'price_desc':
                    return parseFloat(b.price) - parseFloat(a.price);
                default:
                    return 0;
            }
        });

        // Update the display
        updateGameDisplay();
    }

    function updateGameDisplay() {
        const browseList = document.getElementById('browseList');
        browseList.innerHTML = '';

        if (filteredGames.length === 0) {
            browseList.innerHTML = '<div class="no-results">No games found matching your search criteria.</div>';
            return;
        }

        let currentRow = null;
        filteredGames.forEach((game, index) => {
            if (index % 5 === 0) {
                currentRow = document.createElement('div');
                currentRow.className = 'browseListRow';
                browseList.appendChild(currentRow);
            }

            const gameCard = document.createElement('div');
            gameCard.className = 'smallGameCard';
            gameCard.onclick = () => GoToDetailPage(game.ID);
            gameCard.innerHTML = `
                <img src="/assets/Images/${game.imgPath}/Logo.png">
                <h2>${game.name}</h2>
                <h3>${game.price} $</h3>
            `;
            currentRow.appendChild(gameCard);
        });
    }

    // Initialize the display
    applyFilters();
</script>