<%- include('../Component/header') %>
            <div id="content">
                <div class="leftCart">
                    <fieldset class="boxfield">
                        <legend>My cart</legend>
                        <% for (let i = 0; i < cartItems.length; i++) { %>
                            <div class="cartGameCard">
                                <img src="/assets/Images/<%= cartItems[i].imgPath %>/Logo.png" alt="">
                                <div class="cartTextDiv">
                                    <h1><%= cartItems[i].name %></h1>
                                    <input type="button" value="Remove" class="removeButton" onclick="RemoveFromCollection('cart', <%=cartItems[i].ID%>)"> 
                                    <h2><%= cartItems[i].price %>$</h2>
                                    <br>
                                    <h4>Release: <%= cartItems[i].releaseDate.substring(0, 10) %></h4>
                                </div>
                            </div>
                        <% } %>
                    </fieldset>
                </div>

                <div class="rightCart">
                    <fieldset class="boxfield">
                        <legend>Sumary</legend>
                        <h1>Items : <%= cart.amount %></h1>
                        <h1>Price : $ <%= cart.totalPrice %></h1>
                        <h1>-----------------------------</h1>
                        <input type="button" value="Checkout" class="signinbutton" onclick="GoToPaymentPage()">
                    </fieldset>  
                </div>
                
            </div>

<%- include('../Component/footer') %>

<script>
    async function GoToPaymentPage(){
        const user = JSON.parse(localStorage.getItem('loggedInUser'));
        const userId = user.ID;
        
        const response = await fetch(`http://localhost:5000/api/order/from-user/${userId}`,{
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            // body: JSON.stringify({
            //     GameID: gameId
            // })
        });

        if(!response.ok){
            return;
        }

        alert("Success !");
        const result = await response.json();
        const orderId = result.orderId;
        window.location.href = `/payment/${orderId}`;
    }
</script>