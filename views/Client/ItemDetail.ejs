<%- include('../Component/header') %>

        <div id="content">

            <div id="leftPanel">
                <h1 id="itemNameTitle"><%= game.name %></h1> <br>
                <img src="" id="detailImg">
                <div id="imgSlider">
                    <img src="/assets/Images/<%= game.imgPath %>/Sp2.png" alt="" id="sliderF" onclick="ShowDetailImg(1)">
                    <img src="/assets/Images/<%= game.imgPath %>/Sp3.png" alt="" onclick="ShowDetailImg(2)">
                    <img src="/assets/Images/<%= game.imgPath %>/Sp4.png" alt="" onclick="ShowDetailImg(3)">
                    <img src="/assets/Images/<%= game.imgPath %>/Sp5.png" alt="" onclick="ShowDetailImg(4)">
                    <img src="/assets/Images/<%= game.imgPath %>/Sp6.png" alt="" id="sliderL" onclick="ShowDetailImg(5)">
                </div>

                <div id="genresTag">
                    <h1>Genres</h1> <br>
                    <h3><%= genreName %></h3>
                </div>

                <div id="about">
                    <h1>About this game</h1> <br>
                    <p><%- game.description %></p>
                </div>

                <br> <br>
                <h1>System Requirements</h1>
                <div id="requirement">
                    <% const reqItems = game.requirement.split(';').map(item => item.trim());%>
                    <div class="floatSide">
                        <h1>MINIMUM REQUIREMENTS:</h1> <br>
                        <h3>Requires a 64-bit processor and operating system</h3> <br>
                        <% reqItems.forEach(line => { %>
                            <h2><%= line %></h2>
                          <% }) %>
                    </div>
                </div>
            </div>

            <div id="rightPanel">
                <img src="/assets/Images/<%= game.imgPath %>/Sp1.png">
                <div class="itemTitle">
                    <h4>Realease Date</h4>
                </div>
                <div class="itemData">
                    <h4 id="rDate"><%= game.releaseDate.substring(0, 10) %></h4>
                </div>

                <div class="itemTitle">
                    <h4>Latest Update</h4>
                </div>
                <div class="itemData">
                    <h4 id="lDate"><%= game.latestUpdate.substring(0, 10) %></h4>
                </div>

                <div class="itemTitle">
                    <h4>Developer</h4>
                </div>
                <div class="itemData">
                    <h4 id="dev"><%= game.dev %></h4>
                </div>

                <div class="itemTitle">
                    <h4>Publisher</h4>
                </div>
                <div class="itemData">
                    <h4 id="publisher"><%= game.publisher %></h4>
                </div>

                <h1 id="priceTag"><%= game.price %> $</h1>

                <!-- <input type="button" value="Purchase Now" class="signinbutton" id="checkout" onclick="GoToPayment()"> -->
                <input type="button" value="Add to Cart" class="signinbutton" id="addTocart" onclick="AddToCollection('cart',<%= game.ID %>)">
                <input type="button" value="Add to Wishlist" class="signinbutton" id="addTowishlist" onclick="AddToCollection('wishlist', <%= game.ID %>)">

            </div>

        </div>

       <%- include('../Component/footer') %>

        <script>
            function ShowDetailImg(index) {
                document.getElementById("detailImg").src = "/assets/Images/<%= game.imgPath %>/Sp" + (index+1) + ".png";
            }
            window.onload = function() {
                ShowDetailImg(1);
            }

            function GoToPayment(){
                window.location.href = '/payment/64';
            }

        </script>



