<%- include('../Component/header') %>
            
            <div id="content">
                <div class="centrebox">
                    <fieldset class="boxfield">
                        <legend>Wishlist</legend>
                        <% for (let i = 0; i < wishlistItems.length; i++) { %>
                        <div class="wishlistGameCard">
                            <div class="imgDiv"> <img src="/assets/Images/<%= wishlistItems[i].imgPath %>/Sp1.png" alt=""></div>
                            <div class="contextDiv">
                                <h1><%= wishlistItems[i].name %></h1>
                                <h4>Release: <%= wishlistItems[i].releaseDate.substring(0, 10) %></h4>
                            </div>
                            <div class="functionDiv">
                                <input type="button" value="Remove from wishlist" class="removeButton" onclick="RemoveFromCollection('wishlist', <%= wishlistItems[i].ID %>)">
                                <br> <br> <br> <br> <br> <br>
                                
                                <input type="button" value="Add to cart" class="addButton" onclick="AddToCollection('cart',<%= wishlistItems[i].ID %>)">
                                <h1><%= wishlistItems[i].price %>$</h1>
                            </div>
                        </div>
                        <% } %>


                    </fieldset>
                </div>
                
            </div>

<%- include('../Component/footer') %>