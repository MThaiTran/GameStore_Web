<%- include('../Component/header') %>
        <div id="wrapper">
            
            <div id="content">
                <div class="leftPayment">
                    <h1>Credit card</h1>
                    <br>
                    <form id="paymentForm">
                        <label for="">Name:</label> <br>
                        <input type="text" class="signintextfield" value="<%= user.name %>" required><br>
                        <label for="">Card Number:</label> <br>
                        <input type="text" class="signintextfield" required> <br>
                        <label for="">Expiration:</label> <br>
                        <input type="text" class="signintextfield" required> <br>
                        <label for="">CCV:</label> <br>
                        <input type="text" class="signintextfield" required> <br>
                    </form>
                </div>

                <div class="rightPayment">
                    <fieldset class="boxfield">
                        <legend>Sumary</legend>
                        <% for (let i = 0; i < orderItems.length; i++) { %>
                        <div class="paymentGameCard">
                            <img src="/assets/Images/<%= orderItems[i].imgPath %>/Logo.png" alt="">
                            <div class="rightDiv">
                                <h1><%= orderItems[i].name %></h1>
                                <h3><%= orderItems[i].price %>$</h3>
                            </div>
                        </div>
                        <% } %>
                        
                        <h1>-----------------------------------</h1>
                        <br>
                        <h1>Items : <%= order.amount %></h1>
                        <h1>Price : $ <%= order.totalPrice %></h1>
                        <br>
                        <input type="submit" value="Checkout" class="signinbutton" onclick="CheckOut()">
                    </fieldset>
                </div>
                
            </div>
            
        </div>
<%- include('../Component/footer') %>

<script>
    async function CheckOut() {
        const user = JSON.parse(localStorage.getItem('loggedInUser'));
        const userId = user.ID;
        const order = <%- JSON.stringify(order) %>;
        const orderItems = <%- JSON.stringify(orderItems) %>;
        
        // Get form data
        const form = document.getElementById('paymentForm');
        const cardNumber = form.querySelector('input[type="text"]:nth-of-type(2)').value;
        const expiration = form.querySelector('input[type="text"]:nth-of-type(3)').value;
        const ccv = form.querySelector('input[type="text"]:nth-of-type(4)').value;

        // Basic credit card validation
        // if (!validateCard(cardNumber, expiration, ccv)) {
        //     alert('Please enter valid credit card information');
        //     return;
        // }

        try {
            const response = await fetch('http://localhost:5000/api/order/<%= order.ID %>', {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token')}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    totalPrice: <%= order.totalPrice%>,
                    UserID: userId,
                    amount: <%= order.amount%>,
                    clientName: user.name,
                    clientMail: user.email,
                    cardNumber: cardNumber,
                    cardExp: expiration,
                    orderDate: new Date(),
                    status: 'Successful',
                    games: <%- JSON.stringify(orderItems.map(item => item.ID)) %>
