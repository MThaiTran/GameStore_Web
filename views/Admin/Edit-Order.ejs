<%- include('../Component/header') %>

<div id="content">
    <div class="centre" style="width: 600px;">
        <form class="addOrder" id="editOrderForm">
            <h1>Edit order</h1>
            <label for="UserID">UserID: </label>
            <input type="number" id="UserID" name="UserID" value="<%= order.UserID %>" required> <br>

            <label for="games">Choose Games:</label>
            <select id="games" name="games[]" multiple size="5">
                <% for(let i=0; i<games.length; i++) { %>
                    <option value="<%= games[i].ID %>" 
                            data-price="<%= games[i].price %>"
                            <%= orderItems.includes(games[i].ID) ? 'selected' : '' %>>
                        <%= games[i].name %>
                    </option>
                <% } %>
            </select> <br>

            <label for="amount">Amount: </label>
            <input type="number" id="amount" name="amount" value="<%= order.amount %>" readonly> <br>

            <label for="totalPrice">Total Price: </label>
            <input type="number" id="totalPrice" name="totalPrice" value="<%= order.totalPrice %>"> <br>

            <label for="clientName">ClientName: </label>
            <input type="text" id="clientName" name="clientName" value="<%= order.clientName %>" required> <br>

            <label for="clientMail">ClientMail: </label>
            <input type="text" id="clientMail" name="clientMail" value="<%= order.clientMail %>" required> <br>

            <label for="cardNumber">CardNumber: </label>
            <input type="number" id="cardNumber" name="cardNumber" value="<%= order.cardNumber %>" required> <br>

            <label for="cardExp">CardExp: </label>
            <input type="number" id="cardExp" name="cardExp" value="<%= order.cardExp %>" required> <br>

            <label for="orderDate">OrderDate: </label>
            <input type="date" id="orderDate" name="orderDate" value="<%= order.orderDate %>" required> <br>

            <label for="status">Status: </label>
            <select name="status" id="status" required>
                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select> <br>

            <br>
            <button type="submit" class="signinbutton">Save</button>
            <a href="/admin/orders" class="signinbutton">Go back</a>
        </form>
    </div>
</div>

<%- include('../Component/footer') %>

<script>
    // Function to calculate amount and total price
    function calculateTotal() {
        const gamesSelect = document.getElementById('games');
        const selectedOptions = gamesSelect.selectedOptions;
        let totalPrice = 0;
        
        // Calculate total price from selected games
        for (let option of selectedOptions) {
            totalPrice += parseInt(option.dataset.price);
        }
        
        // Update amount and total price fields
        document.getElementById('amount').value = selectedOptions.length;
        document.getElementById('totalPrice').value = totalPrice;
    }

    // Add event listener to games select
    document.getElementById('games').addEventListener('change', calculateTotal);

    // Calculate initial values when page loads
    calculateTotal();

    document.getElementById('editOrderForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Get selected games and convert to array of game IDs
        const selectedGames = Array.from(document.getElementById('games').selectedOptions).map(option => option.value.trim());
        
        const orderData = {
            totalPrice: document.getElementById('totalPrice').value,
            UserID: document.getElementById('UserID').value,
            amount: document.getElementById('amount').value,
            clientName: document.getElementById('developer').value,
            clientMail: document.getElementById('publisher').value,
            cardNumber: document.getElementById('cardNumber').value,
            cardExp: document.getElementById('cardExp').value,
            orderDate: document.getElementById('orderDate').value,
            status: document.getElementById('status').value,
            games: selectedGames
        };

        try {
            const response = await fetch(`http://localhost:5000/api/order/<%= order.ID %>`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(orderData)
            });

            if (!response.ok) {
                throw new Error('Failed to update order');
            }

            alert('Order updated successfully!');
            window.location.href = '/admin/orders';
        } catch (error) {
            console.error('Error:', error);
            alert('Failed to update order. Please try again.');
        }
    });
</script> 