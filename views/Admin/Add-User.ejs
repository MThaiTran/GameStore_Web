<%- include('../Component/header') %>

<div id="content">
    <div class="centre" style="width: 600px;">
        <form action="" class="addUser">
            <h1>Add new user</h1>
            <label for="">Username: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Email address: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Name: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Phone: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Date of birth: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Gender :</label> 
            <label for="">Male</label>
            <input type="radio"name="gender">
            <label for="">Female</label>
            <input type="radio"name="gender"> <br>

            <label for="">Address: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Role: </label>
            <select name="" id="" class="addNewTextField" style="height: 120%;">
                <option value="">Select role</option>
                <option value="">Admin</option>
                <option value="">User</option>
            </select> <br>

            <label for="">Password: </label>
            <input type="text" class="addNewTextField"> <br>

            <label for="">Confirm password: </label>
            <input type="text" class="addNewTextField"> <br>

            <br>
            <input type="button" value="Save" class="signinbutton">
            <a href="/admin/users" class="signinbutton">Go back</a>
        </form>
    </div>
</div>

<%- include('../Component/footer') %>