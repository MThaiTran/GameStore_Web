<%- include('../Component/header') %>
    <div id="content">
        <div class="centre" style="width: 1300px;">
            <a href="/admin/users" class="signinbutton">UserList</a>
            <a href="/admin/games" class="signinbutton">GameList</a>
            <a href="/admin/genres" class="signinbutton">GenreList</a>
            <a href="/admin/orders" class="signinbutton">OrderList</a>
            <a href="/admin/add-order" class="signinbutton" style="float: right;">Add new</a>
        </div>
            <div class="centre" style="width: 1300px;">
                <h1>ORDERS</h1>
                <table class="userListTable">
                    <tr>
                        <th>ID</th>
                        <th>Total Price</th>
                        <th>Amount</th>
                        <th>UserID</th>
                        <th>Client Name</th>
                        <th>Client Mail</th>
                        <th>Card Number</th>
                        <th>Card Exp</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th>Function</th>
                    </tr>

                    <% for(let i=0; i<orders.length; i++) { %>
                    <tr>
                        <td class="ellipsis"><%= orders[i].ID %></td>
                        <td class="ellipsis"><%= orders[i].totalPrice %></td>
                        <td class="ellipsis"><%= orders[i].amount %></td>
                        <td class="ellipsis"><%= orders[i].UserID %></td>
                        <td class="ellipsis"><%= orders[i].clientName %></td>
                        <td class="ellipsis"><%= orders[i].clientMail %></td>
                        <td class="ellipsis"><%= orders[i].cardNumber %></td>
                        <td class="ellipsis"><%= orders[i].cardExp %></td>
                        <td class="ellipsis"><%= orders[i].orderDate.substring(0,10) %></td>
                        <td class="ellipsis"><%= orders[i].status %></td>
                        <td>
                            <!-- <a href="#">ShowItems</a> -->
                            <a href="/admin/edit-order/<%= orders[i].ID %>">Edit</a>
                            <input type="button" onclick="Delete(<%= orders[i].ID %>)" value="Delete">
                        </td>
                    </tr>
                    <% } %>
                </table>
                <div class="pagination" style="text-align: center; margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/orders?page=<%= currentPage - 1 %>" class="signinbutton" style="min-width: 100px;">Previous</a>
                    <% } %>
                    
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/admin/orders?page=<%= i %>" class="signinbutton" 
                           style="min-width: 40px; <%= currentPage === i ? 'background-color: #4CAF50; color: white;' : '' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/orders?page=<%= currentPage + 1 %>" class="signinbutton" style="min-width: 100px;">Next</a>
                    <% } %>
                </div>
        </div>
    </div>

<%- include('../Component/footer') %>

<script>
    async function Delete(orderId) {
        const response = await fetch(`http://localhost:5000/api/order/${orderId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
                // 'Content-Type': 'application/json'
            },
        });

        if(!response.ok) {
            alert("Failed to delete!");
            return;
        }

        alert("Delete successful!");
        window.location.reload();
    }
</script>