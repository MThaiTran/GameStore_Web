<%- include('../Component/header') %>
    <div id="content">
        <div class="centre" style="width: 1300px;">
            <a href="/admin/users" class="signinbutton">UserList</a>
            <a href="/admin/games" class="signinbutton">GameList</a>
            <a href="/admin/genres" class="signinbutton">GenreList</a>
            <a href="/admin/orders" class="signinbutton">OrderList</a>
            <a href="/admin/upload-images" class="signinbutton" >Upload Images</a>
            <a href="/admin/add-game" class="signinbutton" style="float: right;">Add new</a>
        </div>
            <div class="centre" style="width: 1300px;">
                <h1>GAMES</h1>
                <table class="userListTable">
                    <tr>
                        <th>Game logo</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Release Date</th>
                        <th>Lastest Update</th>
                        <th>Developer</th>
                        <th>Publisher</th>
                        <th>Price</th>
                        <th>Genres</th>
                        <th>FolderPath</th>
                        <th>Description</th>
                        <th>Requirements</th>
                        <th>ShortDescribe</th>
                        <th>Function</th>
                    </tr>

                    <% for(let i=0; i<games.length; i++) { %>
                    <tr>
                        <td><img src="/assets/Images/<%= games[i].imgPath %>/Logo.png" width="100px" height="100px"></td>
                        <td class="ellipsis"><%= games[i].ID %></td>
                        <td class="ellipsis"><%= games[i].name %></td>
                        <td class="ellipsis"><%= games[i].releaseDate.substring(0, 10) %></td>
                        <td class="ellipsis"><%= games[i].latestUpdate.substring(0, 10) %></td>
                        <td class="ellipsis"><%= games[i].dev %></td>
                        <td class="ellipsis"><%= games[i].publisher %></td>
                        <td class="ellipsis"><%= games[i].price %></td>
                        <td class="ellipsis"><%= games[i].GenreID %></td>
                        <td class="ellipsis"><%= games[i].imgPath %></td>
                        <td class="ellipsis"><%= games[i].description %></td>
                        <td class="ellipsis"><%= games[i].requirement %></td>
                        <td class="ellipsis"><%= games[i].shortDescribe %></td>
                        <td>
                            <a href="/admin/edit-game/<%= games[i].ID %>">Edit</a>
                            <input type="button" onclick="Delete(<%= games[i].ID %>)" value="Delete">
                        </td>
                    </tr>
                    <% } %>
                </table>
                <div class="pagination" style="text-align: center; margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/games?page=<%= currentPage - 1 %>" class="signinbutton" style="min-width: 100px;">Previous</a>
                    <% } %>
                    
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/admin/games?page=<%= i %>" class="signinbutton" 
                           style="min-width: 40px; <%= currentPage === i ? 'background-color: #4CAF50; color: white;' : '' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/games?page=<%= currentPage + 1 %>" class="signinbutton" style="min-width: 100px;">Next</a>
                    <% } %>
                </div>
        </div>
    </div>

<%- include('../Component/footer') %>

<script>
    async function Delete(gameId) {
        const response = await fetch(`http://localhost:5000/api/game/${gameId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
                // 'Content-Type': 'application/json'
            },
        });

        if(!response.ok) {
            alert("Failed to delete!");
            return;
        }

        alert("Delete successful!");
        window.location.reload();
    }
</script>