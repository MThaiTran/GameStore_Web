<%- include('header') %>
            <div id="content">
                <div class="centre">
                    <h1>Account Information</h1>
                    <form action="">
                        <div class="leftPart">
                            <label for="">Account Name :</label> <br>
                            <input type="text" class="datafield">
                        </div>
                        <div class="rightPart">
                            <label for="">Email Address :</label> <br>
                            <input type="text" class="datafield">
                        </div>
                    </form>
                </div>

                <div class="centre">
                    <h1>Personal Details</h1>
                    <form action="">
                        <div class="leftPart">
                            <label for="">Name :</label> <br>
                            <input type="text" class="datafield"> <br>
                            <label for="">Date of Birth :</label> <br>
                            <input type="date" class="datafield"> <br>
                            <label for="">Address :</label> <br>
                            <input type="text" class="datafield"> <br>
                        </div>
                        <div class="rightPart">
                            <label for="">Phone Number :</label> <br>
                            <input type="text" class="datafield"> <br>
                            <br> <br> <br>
                            <label for="">Gender :</label> 
                            <label for="">Male</label>
                            <input type="radio"name="gender">
                            <label for="">Female</label>
                            <input type="radio"name="gender"> <br>

                            <br>
                            <label for="" style="margin-top: 20px;">City and Country :</label> <br>
                            <input type="text" class="datafield">
                        </div>
                    </form>
                </div>

                <div class="centre">
                    <h1>Password - Change password</h1>
                    <form action="">
                        <div class="leftPart" id="pass">
                            <label for="">Current password :</label> <br>
                            <input type="text" class="datafield">
                        </div>
                        <div class="rightPart" id="pass">
                            <label for="">New password :</label> <br>
                            <input type="text" class="datafield"> <br>
                            <label for="">Confirm password :</label> <br>
                            <input type="text" class="datafield">
                            
                        </div>
                        <input type="button" class="signinbutton" value="Change password" onclick="ChangePassword()">
                    </form>
                </div>

                <input type="button" class="signinbutton" value="Save changes" id="saveProfile" onclick="SaveChanges()">
            </div>
<%- include('footer') %>