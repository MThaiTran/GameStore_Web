<%- include('header') %>

    <div id="content">
        <div id="centre">
            <div id="feature">
                <h1>Featured & Recommended</h1>
                <div id="bigImage">
                    <div class="funcButton" id="buy" onclick="PurchaseGame()">
                        <h2>Purchase Now</h2>
                    </div>

                    <div class="funcButton" id="add" onclick="AddToWishlist()">
                        <h2>Add to Wishlist</h2>
                    </div>
                </div>

                <div id="featureItemList">
                    <% for (let i=0; i < 5; i++) { %>
                        <div class="featureItem" id="fItem<%=i+1 %>" onclick="ShowBigImage( <%= i%> )">
                            <img src="assets/Images/<%=games[i].imgPath %>/Logo.png">
                            <h2>
                                <%= games[i].name %>
                            </h2>
                        </div>
                        <% } %>
                </div>
            </div>

            <div id="bestSeller">
                <h1>Best Seller Games</h1>

                <% for (let i=0; i < 5; i++) { %>
                    <div class="smallGameCard" onclick="GoToDetailPage(<%=games[i].ID%>)">
                        <img src="assets/Images/<%=games[i].imgPath %>/Logo.png">
                        <h2>
                            <%= games[i].name %>
                        </h2>
                        <h3>9,99 $</h3>
                    </div>
                    <% } %>

                        <% for (let i=0; i < 3; i++) { %>
                            <div class="mediumGameCard" onclick="GoToDetailPage(<%=games[i].ID%>)">
                                <img src="assets/Images/<%=games[i].imgPath %>/Sp1.png">
                                <h2>
                                    <%= games[i].name %>
                                </h2>
                                <p>Short discription of the game</p>
                                <h3>9,99 $</h3>
                            </div>
                            <% } %>

            </div>

            <div id="popular">
                <h1>Popular Games</h1>
                <a href="/browse">See more...</a>

                <% for (let i=0; i < 5; i++) { %>
                    <div class="smallGameCard" onclick="GoToDetailPage(<%=games[i].ID%>)">
                        <img src="assets/Images/<%=games[i].imgPath %>/Logo.png">
                        <h2>
                            <%= games[i].name %>
                        </h2>
                        <h3>9,99 $</h3>
                    </div>
                    <% } %>
            </div>
            <div id="popular">
                <h1>Genres</h1>
                <a href="/browse">See more...</a>

                <% for (let i=0; i < 5; i++) { %>
                    <div class="genresCard">
                        <div>
                            <h2>RPG</h2>
                        </div>
                    </div>
                    <% } %>
            </div>

            <div id="popular">
                <h1>Free Games</h1>
                <a href="/browse">See more...</a>

                <% for (let i=0; i < 3; i++) { %>
                    <div class="mediumGameCard" onclick="GoToDetailPage(<%=games[i].ID%>)">
                        <img src="assets/Images/<%=games[i].imgPath %>/Sp1.png">
                        <h2>
                            <%= games[i].name %>
                        </h2>
                        <p>Short discription of the game</p>
                        <h3>9,99 $</h3>
                    </div>
                    <% } %>
            </div> 
        </div>
    </div>

    <%- include('footer') %>

    <script>
        const games = <%- JSON.stringify(games) %>;
        let currentGameID = games[0].ID;

        function ShowBigImage(index) {
            currentGameID = games[index].ID;
            let imgPath = "assets/Images/" + games[index].imgPath + "/Sp1.png";
            document.getElementById("bigImage").style.backgroundImage = `url('${imgPath}')`;
        }

        function GoToDetailPage(gameID) {
            window.location.href = `/games/${gameID}`;
        }

        function PurchaseGame() {
            console.log(currentGameID);
            window.location.href = `/games/${currentGameID}`;
        }

        window.onload = function() {
            ShowBigImage(0);
        }

    </script>






